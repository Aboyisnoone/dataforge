# DataForge Environment Configuration

# Database
# Default is SQLite for local development. For production, use PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/dataforge
DATABASE_URL=sqlite:///./dataforge.db

# Storage Backend
# Options: "local" (default) or "s3"
STORAGE_BACKEND=local

# S3 Configuration (Required if STORAGE_BACKEND=s3)
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=dataforge

# AI Copilot
# Gemini API Key (Required for AI Investigation features)
GEMINI_API_KEY=your_gemini_api_key_here

# Authentication
# Set to False to enforce JWT authentication (Workspace Isolation)
AUTH_DISABLED=True
# JWT_JWKS_URL=https://your-auth-provider.com/.well-known/jwks.json

# Limits
# Max upload size in bytes (Default: 1GB)
MAX_UPLOAD_SIZE_BYTES=1073741824
